# Database — defaults to an absolute-path SQLite file in backend/.
# Override for MySQL:  mysql+pymysql://root:rootpassword@localhost:3306/deutschcoach
# DATABASE_URL=sqlite:///C:/Users/saari/projects/german-tutor-chatbot/backend/deutschcoach.db
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CORS_ORIGIN=http://localhost:3000
ANTHROPIC_API_KEY=  # Optional — leave empty to disable chat. Get from https://platform.deepseek.com/api-keys
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic  # Anthropic-compatible endpoint (DeepSeek)
ANTHROPIC_MODEL=deepseek-v4-flash  # Model name for the /v1/messages endpoint

# Native Audio (Section 11.1) — CDN-backed signed URL delivery
# CDN_PROVIDER=local        # "local" | "r2" | "s3"
# CDN_BUCKET=deutschcoach-audio
# CDN_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# CDN_ACCESS_KEY=your-access-key
# CDN_SECRET_KEY=your-secret-key
# CDN_PUBLIC_URL=https://audio.deutschcoach.app
# AUDIO_SIGNING_SECRET=change-me-to-a-random-string
# NATIVE_AUDIO_LEVELS=A1,A2  # Comma-separated CEFR levels with native audio

# Email (SMTP) — optional for password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@deutschcoach.app
FRONTEND_URL=http://localhost:3456
